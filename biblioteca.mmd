classDiagram
    class Biblioteca{
        +MAXIMO_PRESTADO: int$
        +NUM_MAXIMO_LIBROS_PRESTADOS: int$

    }

    class Libro{
        -nombre: String
        -tipo: TipoLibroEnum
        -editorial: String
        -anio: int
    }

    note for Libro "<strong> TipoLibroEnum </strong> <br>NOVELA<br>TEATRO<br>POESIA<br>ENSAYO"

    class Autor{
        -nombre: String
        -nacionalidad: String
        -fechaDeNacimiento: Date
    }

    note for Copia "<strong> EstadoCopiaEnum </strong> <br>BIBLIOTECA<br>PRESTADA<br>RETRASO<br>REPARACIÓN"

    class Copia{
        -identificador: int
        -estado: EstadoCopiaEnum
    }

    class Lector{
        -diaMulta: Date
        -diasMultado: int
    }

    class Prestamo{
        -fechaInicio: Date
        -fechaDevolucion: Date
    }
    
    Libro "1.." --* "1-1" Autor
    Copia --|> Libro
    Libro "1" --* "1..*" Copia
    Lector "1..*" --o "1..*" Prestamo
    Copia "1" --o "1..*" Prestamo
    Libro *-- Biblioteca
    Copia *-- Biblioteca